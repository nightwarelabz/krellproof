extern malloc(i64) -> ptr
fn main() -> i64 {
  entry():
    %buf = call ptr malloc(4194304)
    %hist = call ptr malloc(2048)
    br bf(0, %buf, %hist)
  bf(i: i64, buf: ptr, hist: ptr):
    %c = icmp.slt i64 i, 4194304
    condbr %c, bfb(i, buf, hist), reps(0, buf, hist)
  bfb(i: i64, buf: ptr, hist: ptr):
    %i32 = trunc i32 i
    %m = mul i32 %i32, 1103515245
    %a = add i32 %m, 12345
    %s = lshr i32 %a, 16
    %b = and i32 %s, 255
    %bb = trunc i8 %b
    %p = gep i8 buf, i
    store i8 %p, %bb
    %i2 = add i64 i, 1
    br bf(%i2, buf, hist)
  reps(r: i64, buf: ptr, hist: ptr):
    %c = icmp.slt i64 r, 1
    condbr %c, hz(0, r, buf, hist), cs(0, 0, hist)
  hz(i: i64, r: i64, buf: ptr, hist: ptr):
    %c = icmp.slt i64 i, 256
    condbr %c, hzb(i, r, buf, hist), docall(r, buf, hist)
  hzb(i: i64, r: i64, buf: ptr, hist: ptr):
    %p = gep i64 hist, i
    store i64 %p, 0
    %i2 = add i64 i, 1
    br hz(%i2, r, buf, hist)
  docall(r: i64, buf: ptr, hist: ptr):
    call void histo(buf, 4194304, hist)
    %r2 = add i64 r, 1
    br reps(%r2, buf, hist)
  cs(i: i64, s: i64, hist: ptr):
    %c = icmp.slt i64 i, 256
    condbr %c, csb(i, s, hist), fin(s)
  csb(i: i64, s: i64, hist: ptr):
    %p = gep i64 hist, i
    %v = load i64, %p
    %w = add i64 i, 1
    %t = mul i64 %w, %v
    %s2 = add i64 s, %t
    %i2 = add i64 i, 1
    br cs(%i2, %s2, hist)
  fin(s: i64):
    ret s
}
