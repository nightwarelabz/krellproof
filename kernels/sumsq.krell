fn sumsq(ptr, i64) -> i64 {
  entry(a: ptr, n: i64):
    br loop(0, 0, a, n)
  loop(i: i64, s: i64, a: ptr, n: i64):
    %c = icmp.slt i64 i, n
    condbr %c, body(i, s, a, n), done(s)
  body(i: i64, s: i64, a: ptr, n: i64):
    %p = gep i64 a, i
    %v = load i64, %p
    %sq = mul i64 %v, %v
    %s2 = add i64 s, %sq
    %i2 = add i64 i, 1
    br loop(%i2, %s2, a, n)
  done(s: i64):
    ret s
}
