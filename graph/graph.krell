fn rd32_3(i64) -> i64 {
  entry(elem: i64):
    %bp = dataptr 3
    %base = mul i64 elem, 4
    %p0 = gep i8 %bp, %base
    %b0 = load i8, %p0
    %v0 = zext i64 %b0
    %o1 = add i64 %base, 1
    %p1 = gep i8 %bp, %o1
    %b1 = load i8, %p1
    %w1 = zext i64 %b1
    %s1 = shl i64 %w1, 8
    %v1 = add i64 %v0, %s1
    %o2 = add i64 %base, 2
    %p2 = gep i8 %bp, %o2
    %b2 = load i8, %p2
    %w2 = zext i64 %b2
    %s2 = shl i64 %w2, 16
    %v2 = add i64 %v1, %s2
    %o3 = add i64 %base, 3
    %p3 = gep i8 %bp, %o3
    %b3 = load i8, %p3
    %w3 = zext i64 %b3
    %s3 = shl i64 %w3, 24
    %v3 = add i64 %v2, %s3
    ret %v3
}

fn rd32_4(i64) -> i64 {
  entry(elem: i64):
    %bp = dataptr 4
    %base = mul i64 elem, 4
    %p0 = gep i8 %bp, %base
    %b0 = load i8, %p0
    %v0 = zext i64 %b0
    %o1 = add i64 %base, 1
    %p1 = gep i8 %bp, %o1
    %b1 = load i8, %p1
    %w1 = zext i64 %b1
    %s1 = shl i64 %w1, 8
    %v1 = add i64 %v0, %s1
    %o2 = add i64 %base, 2
    %p2 = gep i8 %bp, %o2
    %b2 = load i8, %p2
    %w2 = zext i64 %b2
    %s2 = shl i64 %w2, 16
    %v2 = add i64 %v1, %s2
    %o3 = add i64 %base, 3
    %p3 = gep i8 %bp, %o3
    %b3 = load i8, %p3
    %w3 = zext i64 %b3
    %s3 = shl i64 %w3, 24
    %v3 = add i64 %v2, %s3
    ret %v3
}

fn rd32_5(i64) -> i64 {
  entry(elem: i64):
    %bp = dataptr 5
    %base = mul i64 elem, 4
    %p0 = gep i8 %bp, %base
    %b0 = load i8, %p0
    %v0 = zext i64 %b0
    %o1 = add i64 %base, 1
    %p1 = gep i8 %bp, %o1
    %b1 = load i8, %p1
    %w1 = zext i64 %b1
    %s1 = shl i64 %w1, 8
    %v1 = add i64 %v0, %s1
    %o2 = add i64 %base, 2
    %p2 = gep i8 %bp, %o2
    %b2 = load i8, %p2
    %w2 = zext i64 %b2
    %s2 = shl i64 %w2, 16
    %v2 = add i64 %v1, %s2
    %o3 = add i64 %base, 3
    %p3 = gep i8 %bp, %o3
    %b3 = load i8, %p3
    %w3 = zext i64 %b3
    %s3 = shl i64 %w3, 24
    %v3 = add i64 %v2, %s3
    ret %v3
}

fn rd32_8(i64) -> i64 {
  entry(elem: i64):
    %bp = dataptr 8
    %base = mul i64 elem, 4
    %p0 = gep i8 %bp, %base
    %b0 = load i8, %p0
    %v0 = zext i64 %b0
    %o1 = add i64 %base, 1
    %p1 = gep i8 %bp, %o1
    %b1 = load i8, %p1
    %w1 = zext i64 %b1
    %s1 = shl i64 %w1, 8
    %v1 = add i64 %v0, %s1
    %o2 = add i64 %base, 2
    %p2 = gep i8 %bp, %o2
    %b2 = load i8, %p2
    %w2 = zext i64 %b2
    %s2 = shl i64 %w2, 16
    %v2 = add i64 %v1, %s2
    %o3 = add i64 %base, 3
    %p3 = gep i8 %bp, %o3
    %b3 = load i8, %p3
    %w3 = zext i64 %b3
    %s3 = shl i64 %w3, 24
    %v3 = add i64 %v2, %s3
    ret %v3
}

fn palc_6(i64, i64) -> i64 {
  entry(idx: i64, ch: i64):
    %bp = dataptr 6
    %t = mul i64 idx, 3
    %o = add i64 %t, ch
    %p = gep i8 %bp, %o
    %b = load i8, %p
    %v = zext i64 %b
    ret %v
}

fn palc_7(i64, i64) -> i64 {
  entry(idx: i64, ch: i64):
    %bp = dataptr 7
    %t = mul i64 idx, 3
    %o = add i64 %t, ch
    %p = gep i8 %bp, %o
    %b = load i8, %p
    %v = zext i64 %b
    ret %v
}

fn pack3(i64, i64, i64) -> i64 {
  entry(r: i64, g: i64, b: i64):
    %rs = shl i64 r, 16
    %gs = shl i64 g, 8
    %t = add i64 %rs, %gs
    %v = add i64 %t, b
    ret %v
}

fn glyph_hit(i64, i64, i64) -> i64 {
  entry(gid: i64, row: i64, col: i64):
    %g = dataptr 1
    %base = mul i64 gid, 7
    %idx = add i64 %base, row
    %p = gep i8 %g, %idx
    %rb = load i8, %p
    %r = zext i64 %rb
    %sh = sub i64 4, col
    %bits = lshr i64 %r, %sh
    %bit = and i64 %bits, 1
    ret %bit
}

fn text_hit(i64, i64, i64, i64, i64, ptr, i64) -> i64 {
  entry(x: i64, y: i64, ox: i64, oy: i64, scale: i64, codes: ptr, n: i64):
    %z = iconst i64 0
    %dx = sub i64 x, ox
    %dy = sub i64 y, oy
    %negx = icmp.slt i64 %dx, 0
    condbr %negx, zero(%z), chky(%dx, %dy, scale, codes, n, %z)
  zero(z: i64):
    ret z
  chky(dx: i64, dy: i64, scale: i64, codes: ptr, n: i64, z: i64):
    %negy = icmp.slt i64 dy, 0
    condbr %negy, zero(z), body(dx, dy, scale, codes, n, z)
  body(dx: i64, dy: i64, scale: i64, codes: ptr, n: i64, z: i64):
    %adv = mul i64 scale, 6
    %cellh = mul i64 scale, 7
    %inrow = icmp.slt i64 dy, %cellh
    condbr %inrow, colchk(dx, dy, scale, codes, n, z, %adv), zero(z)
  colchk(dx: i64, dy: i64, scale: i64, codes: ptr, n: i64, z: i64, adv: i64):
    %tot = mul i64 n, adv
    %incol = icmp.slt i64 dx, %tot
    condbr %incol, cell(dx, dy, scale, codes, z, adv), zero(z)
  cell(dx: i64, dy: i64, scale: i64, codes: ptr, z: i64, adv: i64):
    %ci = udiv i64 dx, adv
    %lx = urem i64 dx, adv
    %cw = mul i64 scale, 5
    %inlet = icmp.slt i64 lx, %cw
    condbr %inlet, pix(dx, dy, scale, codes, %ci, lx), zero(z)
  pix(dx: i64, dy: i64, scale: i64, codes: ptr, ci: i64, lx: i64):
    %gx = udiv i64 lx, scale
    %gy = udiv i64 dy, scale
    %cp = gep i8 codes, ci
    %gb = load i8, %cp
    %gid = zext i64 %gb
    %hit = call i64 glyph_hit(%gid, %gy, %gx)
    ret %hit
}

fn stage_panels(i64, i64, i64) -> i64 {
  entry(x: i64, y: i64, pk: i64):
    br loop(0, x, y, pk)
  loop(i: i64, x: i64, y: i64, pk: i64):
    %c = icmp.slt i64 i, 6
    condbr %c, body(i, x, y, pk), fin(pk)
  body(i: i64, x: i64, y: i64, pk: i64):
    %rec = mul i64 i, 6
    %e0 = add i64 %rec, 0
    %x0 = call i64 rd32_5(%e0)
    %e1 = add i64 %rec, 1
    %y0 = call i64 rd32_5(%e1)
    %e2 = add i64 %rec, 2
    %x1 = call i64 rd32_5(%e2)
    %e3 = add i64 %rec, 3
    %y1 = call i64 rd32_5(%e3)
    %e4 = add i64 %rec, 4
    %fp = call i64 rd32_5(%e4)
    %e5 = add i64 %rec, 5
    %bp = call i64 rd32_5(%e5)
    %ax = icmp.sge i64 x, %x0
    %axz = zext i64 %ax
    %bx = icmp.slt i64 x, %x1
    %bxz = zext i64 %bx
    %ay = icmp.sge i64 y, %y0
    %ayz = zext i64 %ay
    %by = icmp.slt i64 y, %y1
    %byz = zext i64 %by
    %tx = and i64 %axz, %bxz
    %ty = and i64 %ayz, %byz
    %in = and i64 %tx, %ty
    %inb = icmp.ne i64 %in, 0
    condbr %inb, inset(i, x, y, pk, %x0, %y0, %x1, %y1, %fp, %bp), next(i, x, y, pk)
  inset(i: i64, x: i64, y: i64, pk: i64, x0: i64, y0: i64, x1: i64, y1: i64, fp: i64, bp: i64):
    %ex0 = icmp.eq i64 x, x0
    %ex0z = zext i64 %ex0
    %xm = sub i64 x1, 1
    %ex1 = icmp.eq i64 x, %xm
    %ex1z = zext i64 %ex1
    %ey0 = icmp.eq i64 y, y0
    %ey0z = zext i64 %ey0
    %ym = sub i64 y1, 1
    %ey1 = icmp.eq i64 y, %ym
    %ey1z = zext i64 %ey1
    %tx = or i64 %ex0z, %ex1z
    %ty = or i64 %ey0z, %ey1z
    %edge = or i64 %tx, %ty
    %eb = icmp.ne i64 %edge, 0
    condbr %eb, setb(i, x, y, bp), setf(i, x, y, fp)
  setb(i: i64, x: i64, y: i64, pk: i64):
    br next(i, x, y, pk)
  setf(i: i64, x: i64, y: i64, pk: i64):
    br next(i, x, y, pk)
  next(i: i64, x: i64, y: i64, pk: i64):
    %i2 = add i64 i, 1
    br loop(%i2, x, y, pk)
  fin(pk: i64):
    ret pk
}

fn stage_grid(i64, i64, i64) -> i64 {
  entry(x: i64, y: i64, pk: i64):
    br ploop(0, x, y, pk)
  ploop(i: i64, x: i64, y: i64, pk: i64):
    %c = icmp.slt i64 i, 6
    condbr %c, pbody(i, x, y, pk), fin(pk)
  pbody(i: i64, x: i64, y: i64, pk: i64):
    %rec = mul i64 i, 6
    %x0 = call i64 rd32_5(%rec)
    %e1 = add i64 %rec, 1
    %y0 = call i64 rd32_5(%e1)
    %bx = add i64 %x0, 128
    %ry = add i64 %y0, 56
    %ey = add i64 %ry, 280
    %ay = icmp.sge i64 y, %ry
    %ayz = zext i64 %ay
    %by = icmp.slt i64 y, %ey
    %byz = zext i64 %by
    %iny = and i64 %ayz, %byz
    %inyb = icmp.ne i64 %iny, 0
    condbr %inyb, gloop(0, x, y, pk, %bx, i), pnext(i, x, y, pk)
  gloop(gi: i64, x: i64, y: i64, pk: i64, bx: i64, i: i64):
    %c = icmp.slt i64 gi, 5
    condbr %c, gbody(gi, x, y, pk, bx, i), pnext(i, x, y, pk)
  gbody(gi: i64, x: i64, y: i64, pk: i64, bx: i64, i: i64):
    %off = call i64 rd32_8(gi)
    %gx = add i64 bx, %off
    %hit = icmp.eq i64 x, %gx
    condbr %hit, gset(gi, x, y, bx, i), gnext(gi, x, y, pk, bx, i)
  gset(gi: i64, x: i64, y: i64, bx: i64, i: i64):
    %pk = iconst i64 2174793
    br gnext(gi, x, y, %pk, bx, i)
  gnext(gi: i64, x: i64, y: i64, pk: i64, bx: i64, i: i64):
    %g2 = add i64 gi, 1
    br gloop(%g2, x, y, pk, bx, i)
  pnext(i: i64, x: i64, y: i64, pk: i64):
    %i2 = add i64 i, 1
    br ploop(%i2, x, y, pk)
  fin(pk: i64):
    ret pk
}

fn stage_bars(i64, i64, i64) -> i64 {
  entry(x: i64, y: i64, pk: i64):
    br loop(0, x, y, pk)
  loop(i: i64, x: i64, y: i64, pk: i64):
    %c = icmp.slt i64 i, 40
    condbr %c, body(i, x, y, pk), fin(pk)
  body(i: i64, x: i64, y: i64, pk: i64):
    %rec = mul i64 i, 5
    %x0 = call i64 rd32_4(%rec)
    %e1 = add i64 %rec, 1
    %y0 = call i64 rd32_4(%e1)
    %e2 = add i64 %rec, 2
    %x1 = call i64 rd32_4(%e2)
    %e3 = add i64 %rec, 3
    %y1 = call i64 rd32_4(%e3)
    %e4 = add i64 %rec, 4
    %ci = call i64 rd32_4(%e4)
    %ax = icmp.sge i64 x, %x0
    %axz = zext i64 %ax
    %bx = icmp.slt i64 x, %x1
    %bxz = zext i64 %bx
    %ay = icmp.sge i64 y, %y0
    %ayz = zext i64 %ay
    %by = icmp.slt i64 y, %y1
    %byz = zext i64 %by
    %tx = and i64 %axz, %bxz
    %ty = and i64 %ayz, %byz
    %in = and i64 %tx, %ty
    %inb = icmp.ne i64 %in, 0
    condbr %inb, inset(i, x, y, pk, %x0, %y0, %x1, %y1, %ci), next(i, x, y, pk)
  inset(i: i64, x: i64, y: i64, pk: i64, x0: i64, y0: i64, x1: i64, y1: i64, ci: i64):
    %ex0 = icmp.eq i64 x, x0
    %ex0z = zext i64 %ex0
    %xm = sub i64 x1, 1
    %ex1 = icmp.eq i64 x, %xm
    %ex1z = zext i64 %ex1
    %ey0 = icmp.eq i64 y, y0
    %ey0z = zext i64 %ey0
    %ym = sub i64 y1, 1
    %ey1 = icmp.eq i64 y, %ym
    %ey1z = zext i64 %ey1
    %tx = or i64 %ex0z, %ex1z
    %ty = or i64 %ey0z, %ey1z
    %edge = or i64 %tx, %ty
    %d = mul i64 ci, 2
    %di = add i64 %d, %edge
    %r = call i64 palc_6(%di, 0)
    %g = call i64 palc_6(%di, 1)
    %b = call i64 palc_6(%di, 2)
    %np = call i64 pack3(%r, %g, %b)
    br next(i, x, y, %np)
  next(i: i64, x: i64, y: i64, pk: i64):
    %i2 = add i64 i, 1
    br loop(%i2, x, y, pk)
  fin(pk: i64):
    ret pk
}

fn stage_text(i64, i64, i64) -> i64 {
  entry(x: i64, y: i64, pk: i64):
    %sb = dataptr 2
    br loop(0, x, y, pk, %sb)
  loop(i: i64, x: i64, y: i64, pk: i64, sb: ptr):
    %c = icmp.slt i64 i, 90
    condbr %c, body(i, x, y, pk, sb), fin(pk)
  body(i: i64, x: i64, y: i64, pk: i64, sb: ptr):
    %rec = mul i64 i, 6
    %off = call i64 rd32_3(%rec)
    %e1 = add i64 %rec, 1
    %len = call i64 rd32_3(%e1)
    %e2 = add i64 %rec, 2
    %ox = call i64 rd32_3(%e2)
    %e3 = add i64 %rec, 3
    %oy = call i64 rd32_3(%e3)
    %e4 = add i64 %rec, 4
    %sc = call i64 rd32_3(%e4)
    %e5 = add i64 %rec, 5
    %ci = call i64 rd32_3(%e5)
    %codes = gep i8 sb, %off
    %hit = call i64 text_hit(x, y, %ox, %oy, %sc, %codes, %len)
    %is = icmp.eq i64 %hit, 1
    condbr %is, inset(i, x, y, sb, %ci), next(i, x, y, pk, sb)
  inset(i: i64, x: i64, y: i64, sb: ptr, ci: i64):
    %r = call i64 palc_7(ci, 0)
    %g = call i64 palc_7(ci, 1)
    %b = call i64 palc_7(ci, 2)
    %np = call i64 pack3(%r, %g, %b)
    br next(i, x, y, %np, sb)
  next(i: i64, x: i64, y: i64, pk: i64, sb: ptr):
    %i2 = add i64 i, 1
    br loop(%i2, x, y, pk, sb)
  fin(pk: i64):
    ret pk
}

fn shade(i64, i64, ptr) -> i64 {
  entry(x: i64, y: i64, out: ptr):
    %bg = iconst i64 592918
    %p1 = call i64 stage_panels(x, y, %bg)
    %p2 = call i64 stage_grid(x, y, %p1)
    %p3 = call i64 stage_bars(x, y, %p2)
    %p4 = call i64 stage_text(x, y, %p3)
    %r = lshr i64 %p4, 16
    %rc = and i64 %r, 255
    %rt = trunc i8 %rc
    store i8 out, %rt
    %g = lshr i64 %p4, 8
    %gc = and i64 %g, 255
    %gt = trunc i8 %gc
    %o1 = gep i8 out, 1
    store i8 %o1, %gt
    %bc = and i64 %p4, 255
    %bt = trunc i8 %bc
    %o2 = gep i8 out, 2
    store i8 %o2, %bt
    %z = iconst i64 0
    ret %z
}

fn main() -> i64 {
  entry():
    %hdr = dataptr 0
    %w0 = call i64 write(1, %hdr, 17)
    %rowbuf = call ptr malloc(5280)
    br yloop(0, %rowbuf)
  yloop(y: i64, rowbuf: ptr):
    %lt = icmp.slt i64 y, 1290
    condbr %lt, xloop(0, y, rowbuf), fin()
  xloop(x: i64, y: i64, rowbuf: ptr):
    %x3 = mul i64 x, 3
    %out = gep i8 rowbuf, %x3
    %s = call i64 shade(x, y, %out)
    %xn = add i64 x, 1
    %go = icmp.slt i64 %xn, 1760
    condbr %go, xloop(%xn, y, rowbuf), xdone(y, rowbuf)
  xdone(y: i64, rowbuf: ptr):
    %wr = call i64 write(1, rowbuf, 5280)
    %yn = add i64 y, 1
    br yloop(%yn, rowbuf)
  fin():
    %z = iconst i64 0
    ret %z
}
